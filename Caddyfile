{
	# Журнал ошибок нужен, чтобы чинить несоединившийся звонок,
	# но адреса и заголовки посетителей в нём не остаются.
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers delete
			}
		}
	}
}

aka-gst.ru, www.aka-gst.ru {
  encode zstd gzip

  header Cache-Control "no-cache, must-revalidate"

  # Без завершающего слэша относительные адреса внутри игры уехали бы в корень.
  redir /leela /leela/ 308
  redir /tetris /tetcolor/ 308
  redir /tetris/* /tetcolor/ 308
  redir /tetcolor /tetcolor/ 308
  redir /psy-admin /psy-admin/ 308
  redir /photodata /photodata/ 308
  redir /acid /acid/ 308
  redir /qa-quest /qa-quest/ 308
  redir /praktikum /praktikum/ 308
  redir /meet /meet/ 308

  # Статика сайта версионируется строкой запроса, поэтому её можно кэшировать.
  @assets path /assets/* /favicon.svg
  header @assets Cache-Control "public, max-age=604800"

  handle_path /api/leaderboard/* {
    reverse_proxy leaderboard:8080
  }

  # Общий вход всего сайта. Сервис живёт на уровне сайта (ops/accounts), а не
  # внутри какого-то проекта: одна учётная запись обслуживает Лилу, QA Quest и
  # лидерборд. Префикс не срезается — сервис ждёт полный путь.
  handle /api/auth/* {
    reverse_proxy accounts:8080
  }

  handle /api/progress/* {
    reverse_proxy accounts:8080
  }

  # Keep anonymous analytics collection on the trusted main origin. The Umami
  # admin UI remains isolated on stats.aka-gst.ru.
  handle_path /pulse/* {
    reverse_proxy umami:3000
  }

  handle /_next/* {
    reverse_proxy tetcolor:3000
  }

  handle_path /tetcolor/* {
    reverse_proxy tetcolor:3000
  }

  handle_path /leela/* {
    reverse_proxy leela:8765
  }

  handle_path /lines/* {
    root * /srv/lines
    file_server
  }

  handle_path /knb/* {
    root * /srv/knb
    file_server
  }

  handle_path /coin/* {
    root * /srv/coin
    file_server
  }

  # Страница звонка и выдача токенов. Сам медиатрафик сюда не идёт —
  # он уходит напрямую на meet.aka-gst.ru, минуя Caddy.
  handle_path /meet/* {
    reverse_proxy meet-auth:8090
  }

  root * /srv
  file_server

  # Свой 404 вместо пустой страницы: с ссылками обратно в разделы.
  handle_errors {
    @notfound expression {err.status_code} == 404
    handle @notfound {
      rewrite * /404.html
      file_server
    }

    # Маршруты соседних проектов проксируют на контейнеры, которые могут
    # быть ещё не подняты. Голый 502 читается как сломанный сайт.
    @unavailable expression {err.status_code} >= 502 && {err.status_code} <= 504
    handle @unavailable {
      rewrite * /503.html
      file_server
    }

    respond "{err.status_code} {err.status_text}"
  }
}

stats.aka-gst.ru {
  # The dashboard is private and is opened locally through an SSH tunnel.
  # Keeping the login form off the public internet also prevents false
  # phishing detections on this administrative subdomain.
  header X-Robots-Tag "noindex, nofollow, noarchive"
  respond "Private analytics dashboard" 404
}

meet.aka-gst.ru {
  # Сигналинг LiveKit (WebSocket). Медиа идёт мимо Caddy, напрямую по UDP.
  # 172.18.0.1 — хост со стороны zakriva-net: LiveKit работает в host-сети,
  # поэтому по имени контейнера он недоступен.
  header X-Robots-Tag "noindex, nofollow"
  reverse_proxy 172.18.0.1:7880
}
