{
	# Журнал ошибок нужен, чтобы чинить несоединившийся звонок,
	# но адреса и заголовки посетителей в нём не остаются.
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers delete
			}
		}
	}
}

aka-gst.ru, www.aka-gst.ru {
  encode zstd gzip

  # Кэширование. Общий заголовок на весь сайт стоял с самого начала и делал
  # правило для ассетов ниже бесполезным: по RFC 9111 повторяющийся
  # Cache-Control склеивается, и no-cache в наборе главнее остального.
  # Проверено на боевом — /assets/site.css отдавался с no-cache, то есть
  # версионирование по ?v= не давало ничего, и обложки рассказов
  # перепроверялись при каждом открытии читалки.
  # Поэтому заголовок не дополняем, а сужаем: всё, кроме ассетов.
  @nocache not path /assets/* /favicon.svg
  header @nocache Cache-Control "no-cache, must-revalidate"

  # Заголовки безопасности. Ставятся один раз на весь сайт.
  header {
    # Год HTTPS без права передумать. Без preload: попадание в списки
    # браузеров необратимо, а домен ещё меняется.
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Браузер не должен угадывать тип файла вопреки заголовку.
    X-Content-Type-Options "nosniff"
    # Чужому сайту уходит только origin, и только по HTTPS.
    Referrer-Policy "strict-origin-when-cross-origin"
    # Сайт нельзя открыть в чужом фрейме: защита от кликджекинга.
    X-Frame-Options "SAMEORIGIN"
    # Камера и микрофон разрешены СВОЕМУ origin — на нём живут звонки,
    # глухой запрет сломал бы /meet/. Геолокация не нужна никому.
    Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
    # Первый приём CSP: только то, что не может ничего сломать. Ни
    # default-src, ни script-src, ни form-action — скрипты, стили, шрифты,
    # картинки и рамки не ограничиваются вовсе.
    #
    # Замерено 4 сентября по двадцати страницам: встроенные скрипты почти
    # везде (Тетколор 17, ФотоДата 11), у psy-admin 65 блоков стилей и 13
    # on*-атрибутов — снимок Тильды. Строгая политика погасила бы их МОЛЧА:
    # CSP не даёт ни 404, ни ошибки у человека.
    #
    # Эти три при этом закрывают настоящее: подмену <base> (усилитель XSS),
    # плагины-объекты и кликджекинг. script-src добавляется отдельным шагом,
    # с проверкой каждой игры в браузере.
    Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
    # Не сообщаем, какой сервер и какой версии тут стоит.
    -Server
  }

  # Игра переехала с /knb/ на /stihii/. Старый адрес расходился ссылками,
  # поэтому он не удаляется, а перенаправляется.
  @knb_q {
    path /knb /knb/*
    expression {query} != ""
  }
  redir @knb_q /stihii/?{query} 308
  redir /knb /stihii/ 308
  redir /knb/* /stihii/ 308

  # «Наотмашь» стала основной по адресу своего имени. Решение Сергея от
  # 1 сентября 2026: «сделаем наотмашь основным, а ворм пусть редиректит на
  # него, завтра саша протестирует его» — играет живой человек не из семьи,
  # и попасть он должен на игру, а не на редирект.
  #
  # Файлы при этом ОСТАЮТСЯ в /srv/worm, и туда же выкладывает сессия игры.
  # Копию делать нельзя: она протухнет при первой же их выкладке, и молча.
  # Поэтому /naotmash/ отдаёт те же файлы (см. handle_path ниже), а /worm/
  # перенаправляется. Проверено до правки: внутри игры нет ни одной
  # абсолютной ссылки на /worm/ — только href="/" и /pulse/script.js.
  # «Один удар» стал Hotline Abakan (слово Сергея, 1 сентября 2026).
  # Файлы лежат в /srv/udar и туда же выкладывает сессия игры — копию не
  # делаем, отдаём те же под новым именем. Проверено до правки: внутри
  # игры нет абсолютных ссылок на /udar/, только /pulse/script.js.
  @udar_q {
    path /udar /udar/*
    expression {query} != ""
  }
  redir @udar_q /hotline-abakan/?{query} 308
  redir /udar /hotline-abakan/ 308
  redir /udar/* /hotline-abakan/ 308
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_hotline_abakan_q {
    path /hotline-abakan
    expression {query} != ""
  }
  redir @slash_hotline_abakan_q /hotline-abakan/?{query} 308
  redir /hotline-abakan /hotline-abakan/ 308

  @worm_zapros {
    path /worm /worm/*
    expression {query} != ""
  }
  redir @worm_zapros /naotmash/?{query} 308
  @worm_q {
    path /worm /worm/*
    expression {query} != ""
  }
  redir @worm_q /naotmash/?{query} 308
  redir /worm /naotmash/ 308
  redir /worm/* /naotmash/ 308
  # Без косой черты handle_path не срабатывает, и адрес, набранный руками,
  # отдавал 404. Человек пишет «aka-gst.ru/naotmash», а не «…/naotmash/».
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_naotmash_q {
    path /naotmash
    expression {query} != ""
  }
  redir @slash_naotmash_q /naotmash/?{query} 308
  redir /naotmash /naotmash/ 308

  # Имя, которым игру называют люди, и имя папки — разные вещи, и
  # расходятся они молча. Человек набирает «acid-uno» или «одинудар», видит
  # имя репозитория на гитхабе или помнит, как игра называется на витрине, —
  # и попадает в 404. Просьба Сергея от 1 сентября 2026: «это тоже давай
  # поправим и сделаем редиректы».
  #
  # Сюда идут два вида имён: как называется репозиторий (человек нашёл код и
  # ищет игру) и как игра подписана на витрине. Выдуманных сокращений здесь
  # нет — только те, которые кто-то реально может набрать.
  @acid_uno_q {
    path /acid-uno /acid-uno/*
    expression {query} != ""
  }
  redir @acid_uno_q /acid/?{query} 308
  redir /acid-uno /acid/ 308
  redir /acid-uno/* /acid/ 308
  @uno_q {
    path /uno /uno/*
    expression {query} != ""
  }
  redir @uno_q /acid/?{query} 308
  redir /uno /acid/ 308
  redir /uno/* /acid/ 308

  @neon_lines_q {
    path /neon-lines /neon-lines/*
    expression {query} != ""
  }
  redir @neon_lines_q /lines/?{query} 308
  redir /neon-lines /lines/ 308
  redir /neon-lines/* /lines/ 308

  @tetkolor_q {
    path /tetkolor /tetkolor/*
    expression {query} != ""
  }
  redir @tetkolor_q /tetcolor/?{query} 308
  redir /tetkolor /tetcolor/ 308
  redir /tetkolor/* /tetcolor/ 308
  @tetcolor_columns_q {
    path /tetcolor-columns /tetcolor-columns/*
    expression {query} != ""
  }
  redir @tetcolor_columns_q /tetcolor/?{query} 308
  redir /tetcolor-columns /tetcolor/ 308
  redir /tetcolor-columns/* /tetcolor/ 308

  @odin_udar_q {
    path /odin-udar /odin-udar/*
    expression {query} != ""
  }
  redir @odin_udar_q /hotline-abakan/?{query} 308
  redir /odin-udar /hotline-abakan/ 308
  redir /odin-udar/* /hotline-abakan/ 308

  # ПЕРИМЕТР лежит в папке stealth, а называют его и так, и MGS.
  @perimetr_q {
    path /perimetr /perimetr/*
    expression {query} != ""
  }
  redir @perimetr_q /stealth/?{query} 308
  redir /perimetr /stealth/ 308
  redir /perimetr/* /stealth/ 308
  @mgs_q {
    path /mgs /mgs/*
    expression {query} != ""
  }
  redir @mgs_q /stealth/?{query} 308
  redir /mgs /stealth/ 308
  redir /mgs/* /stealth/ 308

  # «Деревня» живёт по /coin/ — адрес остался от «Орла и решки».
  @derevnya_q {
    path /derevnya /derevnya/*
    expression {query} != ""
  }
  redir @derevnya_q /coin/?{query} 308
  redir /derevnya /coin/ 308
  redir /derevnya/* /coin/ 308
  @orel_reshka_q {
    path /orel-reshka /orel-reshka/*
    expression {query} != ""
  }
  redir @orel_reshka_q /coin/?{query} 308
  redir /orel-reshka /coin/ 308
  redir /orel-reshka/* /coin/ 308

  @bitva_stihiy_q {
    path /bitva-stihiy /bitva-stihiy/*
    expression {query} != ""
  }
  redir @bitva_stihiy_q /stihii/?{query} 308
  redir /bitva-stihiy /stihii/ 308
  redir /bitva-stihiy/* /stihii/ 308

  @neon_claw_q {
    path /neon-claw /neon-claw/*
    expression {query} != ""
  }
  redir @neon_claw_q /claw/?{query} 308
  redir /neon-claw /claw/ 308
  redir /neon-claw/* /claw/ 308

  @technomagia_q {
    path /technomagia /technomagia/*
    expression {query} != ""
  }
  redir @technomagia_q /technomagic/?{query} 308
  redir /technomagia /technomagic/ 308
  redir /technomagia/* /technomagic/ 308
  @tehnomagia_q {
    path /tehnomagia /tehnomagia/*
    expression {query} != ""
  }
  redir @tehnomagia_q /technomagic/?{query} 308
  redir /tehnomagia /technomagic/ 308
  redir /tehnomagia/* /technomagic/ 308

  @tetris_q {
    path /tetris /tetris/*
    expression {query} != ""
  }
  redir @tetris_q /tetcolor/?{query} 308
  redir /tetris /tetcolor/ 308
  redir /tetris/* /tetcolor/ 308
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_tetcolor_q {
    path /tetcolor
    expression {query} != ""
  }
  redir @slash_tetcolor_q /tetcolor/?{query} 308
  redir /tetcolor /tetcolor/ 308
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_psy_admin_q {
    path /psy-admin
    expression {query} != ""
  }
  redir @slash_psy_admin_q /psy-admin/?{query} 308
  redir /psy-admin /psy-admin/ 308
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_photodata_q {
    path /photodata
    expression {query} != ""
  }
  redir @slash_photodata_q /photodata/?{query} 308
  redir /photodata /photodata/ 308
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_acid_q {
    path /acid
    expression {query} != ""
  }
  redir @slash_acid_q /acid/?{query} 308
  redir /acid /acid/ 308
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_qa_quest_q {
    path /qa-quest
    expression {query} != ""
  }
  redir @slash_qa_quest_q /qa-quest/?{query} 308
  redir /qa-quest /qa-quest/ 308
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_praktikum_q {
    path /praktikum
    expression {query} != ""
  }
  redir @slash_praktikum_q /praktikum/?{query} 308
  redir /praktikum /praktikum/ 308
  # Строку запроса надо переносить руками: явный redir её выбрасывает,
  # хотя собственная нормализация Caddy сохраняет (проверено на /claw).
  @slash_meet_q {
    path /meet
    expression {query} != ""
  }
  redir @slash_meet_q /meet/?{query} 308
  redir /meet /meet/ 308

  # Всё под /assets/ подписано хешем в строке запроса (?v=), поэтому старый
  # файл по новому адресу не приедет и год хранения безопасен.
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"

  # Значок версии не несёт: год держать нельзя, иначе смена значка дойдёт
  # до вернувшегося посетителя через год.
  @icon path /favicon.svg
  header @icon Cache-Control "public, max-age=604800"

  handle_path /api/leaderboard/* {
    reverse_proxy leaderboard:8080
  }

  # Форма партнёрства не знает адреса владельца. Проверки полей, honeypot и
  # ограничение частоты находятся в сервисе: браузерную проверку обойти легко.
  handle_path /api/contact/* {
    reverse_proxy contact:8080
  }

  # Дневник пути: бот кладёт событие, страница показывает его сразу.
  # flush_interval -1 обязателен: без него Caddy копит поток событий в
  # буфере, и «сразу» превращается в «когда наберётся», то есть цель в
  # 300 мс не выполняется по устройству, а не по нагрузке.
  handle_path /api/dnevnik/* {
    reverse_proxy dnevnik:8080 {
      flush_interval -1
    }
  }

  # Общий вход всего сайта. Сервис живёт на уровне сайта (ops/accounts), а не
  # внутри какого-то проекта: одна учётная запись обслуживает Лилу, QA Quest и
  # лидерборд. Префикс не срезается — сервис ждёт полный путь.
  handle /api/auth/* {
    reverse_proxy accounts:8080
  }

  handle /api/progress/* {
    reverse_proxy accounts:8080
  }

  # Keep anonymous analytics collection on the trusted main origin. The Umami
  # admin UI remains isolated on stats.aka-gst.ru.
  # Наружу открыты ровно два пути счётчика: файл скрипта и приём событий.
  # Панель и форма входа доступны только на stats.aka-gst.ru (4 сентября 2026).
  @pulse_public path /pulse/script.js /pulse/api/send
  handle @pulse_public {
    uri strip_prefix /pulse
    reverse_proxy umami:3000
  }
  handle /pulse/* {
    respond "Not Found" 404
  }

  handle /_next/* {
    reverse_proxy tetcolor:3000
  }

  handle_path /tetcolor/* {
    reverse_proxy tetcolor:3000
  }


  handle_path /hotline-abakan/* {
    root * /srv/udar
    file_server
  }

  handle_path /naotmash/* {
    root * /srv/worm
    file_server
  }

  handle_path /lines/* {
    root * /srv/lines
    file_server
  }

  handle_path /knb/* {
    root * /srv/knb
    file_server
  }

  handle_path /coin/* {
    root * /srv/coin
    file_server
  }

  # Страница звонка и выдача токенов. Сам медиатрафик сюда не идёт —
  # он уходит напрямую на meet.aka-gst.ru, минуя Caddy.
  handle_path /meet/* {
    reverse_proxy meet-auth:8090
  }

  # Комнаты ACID UNO. Статика игры лежит в /srv/acid и отдаётся файлово —
  # сюда уходят только запросы комнаты. Префикс /acid срезаем: сервер ждёт
  # /api/..., ровно как при локальном запуске.
  #
  # flush_interval -1 обязателен. Состояние стола приходит потоком SSE, и с
  # буферизацией по умолчанию он копится в прокси: у игроков просто замирает
  # стол, без единой ошибки в журнале.
  handle /acid/api/* {
    uri strip_prefix /acid
    reverse_proxy acid-uno:4173 {
      flush_interval -1
    }
  }

  # Booking is a separate service, not static content: the prefix is stripped
  # so V2 can keep its own small application routes and SQLite data volume.
  redir /psy-admin/booking /psy-admin/booking/ 308
  handle_path /psy-admin/booking/* {
    reverse_proxy psy-admin-booking:4180 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  redir /psy-admin/admin /psy-admin/admin/ 308
  handle_path /psy-admin/admin/ {
    rewrite * /admin
    reverse_proxy psy-admin-booking:4180 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
  handle_path /psy-admin/admin/* {
    reverse_proxy psy-admin-booking:4180 {
      header_up Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  root * /srv
  file_server

  # Свой 404 вместо пустой страницы: с ссылками обратно в разделы.
  handle_errors {
    # Обработчик ошибок — ОТДЕЛЬНАЯ цепочка, и header-блок сайта до неё не
    # доходит. Замер 4 сентября: на 404 не было НИ ОДНОГО заголовка
    # безопасности и светился Server, при том что на 200 и на 308 всё стояло.
    # Аудит увидел только утечку Server; отсутствие остальных хуже.
    header {
      Strict-Transport-Security "max-age=31536000; includeSubDomains"
      X-Content-Type-Options "nosniff"
      Referrer-Policy "strict-origin-when-cross-origin"
      X-Frame-Options "SAMEORIGIN"
      Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
      -Server
    }
    @notfound expression {err.status_code} == 404
    handle @notfound {
      rewrite * /404.html
      file_server
    }

    # Маршруты соседних проектов проксируют на контейнеры, которые могут
    # быть ещё не подняты. Голый 502 читается как сломанный сайт.
    #
    # Код приводим к 503: 502 значит «апстрим ответил мусором», а здесь
    # ситуация другая — сервис временно не поднят. Поисковики и мониторинги
    # трактуют 503 как временное и не выбрасывают адрес из индекса.
    @unavailable expression {err.status_code} >= 502 && {err.status_code} <= 504
    handle @unavailable {
      rewrite * /503.html
      header Retry-After 300
      file_server {
        status 503
      }
    }

    respond "{err.status_code} {err.status_text}"
  }
}

stats.aka-gst.ru {
  # The dashboard is private and is opened locally through an SSH tunnel.
  # Keeping the login form off the public internet also prevents false
  # phishing detections on this administrative subdomain.
  header X-Robots-Tag "noindex, nofollow, noarchive"
  respond "Private analytics dashboard" 404
}

meet.aka-gst.ru {
  # Сигналинг LiveKit (WebSocket). Медиа идёт мимо Caddy, напрямую по UDP.
  # 172.18.0.1 — хост со стороны zakriva-net: LiveKit работает в host-сети,
  # поэтому по имени контейнера он недоступен.
  header X-Robots-Tag "noindex, nofollow"
  reverse_proxy 172.18.0.1:7880
}
